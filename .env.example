OPENAI_API_KEY=
# Optional; omit to use the OpenAI default endpoint.
OPENAI_BASE_URL=
DOCPARSE_LUNA_MODEL=gpt-5.6-luna
DOCPARSE_TERRA_MODEL=gpt-5.6-terra
DOCPARSE_LUNA_MAX_OUTPUT_TOKENS=128000
DOCPARSE_TERRA_MAX_OUTPUT_TOKENS=128000
DOCPARSE_RENDER_DPI=200
DOCPARSE_CROP_DPI=450
DOCPARSE_CROP_PADDING=0.05
DOCPARSE_MAX_UPLOAD_BYTES=262144000
DOCPARSE_MAX_PAGES=500
DOCPARSE_MAX_PAGE_PIXELS=20000000
DOCPARSE_PAGE_BATCH_SIZE=100
DOCPARSE_MAX_PAGE_CONCURRENCY=50
DOCPARSE_PROVIDER_CONCURRENCY=50
DOCPARSE_PROVIDER_RETRY_ATTEMPTS=3
DOCPARSE_PROVIDER_RETRY_BASE_SECONDS=0.5
DOCPARSE_PROVIDER_RETRY_CAP_SECONDS=8.0
DOCPARSE_PROVIDER_COOLDOWN_SECONDS=1.0
DOCPARSE_PROVIDER_SUCCESS_WINDOW=10
# Optional run ceilings; leave blank for observation-only diagnostics.
DOCPARSE_MAX_HTTP_ATTEMPTS=
DOCPARSE_MAX_TERRA_ATTEMPTS=
DOCPARSE_MAX_INPUT_TOKENS=
DOCPARSE_MAX_OUTPUT_TOKENS=
DOCPARSE_MAX_ELAPSED_SECONDS=
