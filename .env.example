OPENAI_API_KEY=
# Optional; omit to use the OpenAI default endpoint.
OPENAI_BASE_URL=
GOOGLE_API_KEY=
# Optional loopback override for the independent Windows Ollama service.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCPARSE_CLOUD_MODEL=gpt-5.6-luna
DOCPARSE_LUNA_MAX_OUTPUT_TOKENS=128000
DOCPARSE_LOCAL_OCR_ENABLED=true
DOCPARSE_GLMOCR_CONFIG_PATH=config/glmocr.yaml
DOCPARSE_GLMOCR_LAYOUT_DEVICE=cuda:0
DOCPARSE_PRELOAD_LOCAL_OCR=false
GLMOCR_MAX_MODEL_LEN=32768
GLMOCR_GPU_MEMORY_UTILIZATION=0.85
GLMOCR_PERFORMANCE_MODE=throughput
GLMOCR_MM_PROCESSOR_CACHE_GB=1
GLMOCR_SDK_MAX_WORKERS=16
DOCPARSE_STUDIO_DB_PATH=data/document_studio.sqlite3
DOCPARSE_RENDER_DPI=200
DOCPARSE_CROP_DPI=450
DOCPARSE_CROP_PADDING=0.1
DOCPARSE_MAX_UPLOAD_BYTES=262144000
DOCPARSE_MAX_PAGES=500
DOCPARSE_MAX_PAGE_PIXELS=20000000
DOCPARSE_PAGE_BATCH_SIZE=16
DOCPARSE_MAX_PAGE_CONCURRENCY=8
DOCPARSE_PROVIDER_CONCURRENCY=8
DOCPARSE_MAX_VISUAL_RECOVERY_CROPS=8
# Legacy compatibility; the strict app path does not use full-page fallback.
DOCPARSE_FULL_PAGE_FALLBACK_FRACTION=0.1
DOCPARSE_PROVIDER_RETRY_ATTEMPTS=3
DOCPARSE_PROVIDER_RETRY_BASE_SECONDS=0.5
DOCPARSE_PROVIDER_RETRY_CAP_SECONDS=8.0
DOCPARSE_PROVIDER_COOLDOWN_SECONDS=1.0
DOCPARSE_PROVIDER_SUCCESS_WINDOW=10
