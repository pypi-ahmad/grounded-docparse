{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-policy-v1.schema.json",
  "title": "Grounded DocParse regression policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "direction"
        ],
        "anyOf": [
          { "required": ["minimum"] },
          { "required": ["maximum"] },
          { "required": ["max_regression"] }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "max_regression": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
